  m_Script: {fileID: 11500000, guid: 4527e0134e5e910408d9870a5e9a08bb, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::DialogueTrigger
  lines:
  - text: Ah, de dierentuin! Wat een rustige dag vandaag.
    duration: 2
  - text: Oh hallo daar! Hoor jij hier wel te zijn na sluitingstijd?
    duration: 3
  - text: Oh wacht, natuurlijk! Jij bent het kind van de eigenaren. Jou ouders hebben
      toch wat problemen met de dieren?
    duration: 4.5
  - text: Misschien kunnen we ze helpen!
    duration: 2
  triggerOnlyOnce: 1
